import { NavLink, Outlet } from "react-router-dom";
import { Clapperboard, LogOut } from "lucide-react";
import { useAuth } from "../../context/AuthContext";
import { homeFor } from "../../utils/roles";
import NotificationBell from "./NotificationBell";

const NAV = {
  editor: [
    { to: "/editor", label: "Projects" },
    { to: "/editor/new", label: "New project" },
  ],
  reviewer: [{ to: "/reviewer", label: "Assigned reviews" }],
  head: [{ to: "/head", label: "Final queue" }],
  admin: [
    { to: "/admin", label: "Users" },
    { to: "/admin/activity", label: "Activity" },
    { to: "/notifications", label: "Inbox" },
  ],
};

export default function AppShell() {
  const { user, logout } = useAuth();
  const links = NAV[user?.role] || [];

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900">
      {/* Header */}
      <header className="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div className="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
          
          {/* Brand */}
          <NavLink
            to={homeFor(user?.role)}
            className="flex items-center gap-3"
          >
            <span className="grid h-10 w-10 place-items-center rounded-xl bg-indigo-600 text-white shadow-sm">
              <Clapperboard size={19} />
            </span>

            <div>
              <p className="font-display text-base font-bold tracking-tight text-slate-900">
                VideoFlow
              </p>
              <p className="text-[10px] font-medium uppercase tracking-[0.18em] text-slate-500">
                Review & approve
              </p>
            </div>
          </NavLink>

          {/* Navigation */}
          <nav className="hidden items-center gap-1 md:flex">
            {links.map((l) => (
              <NavLink
                key={l.to}
                to={l.to}
                end={l.to.split("/").length <= 2}
                className={({ isActive }) =>
                  `rounded-lg px-3 py-2 text-sm font-medium transition ${
                    isActive
                      ? "bg-indigo-50 text-indigo-700"
                      : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                  }`
                }
              >
                {l.label}
              </NavLink>
            ))}
          </nav>

          {/* User section */}
          <div className="flex items-center gap-3">
            <NotificationBell />

            <div className="hidden border-l border-slate-200 pl-3 text-right sm:block">
              <p className="text-sm font-semibold text-slate-800">
                {user?.name}
              </p>
              <p className="text-xs capitalize text-slate-500">
                {user?.role}
              </p>
            </div>

            <button
              className="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900"
              onClick={logout}
              type="button"
            >
              <LogOut size={16} />
              <span className="hidden sm:inline">Log out</span>
            </button>
          </div>
        </div>
      </header>

      {/* Page content */}
      <main className="mx-auto min-h-[calc(100vh-65px)] max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <Outlet />
      </main>
    </div>
  );
}