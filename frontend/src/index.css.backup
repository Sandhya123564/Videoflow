@tailwind base;
@tailwind components;
@tailwind utilities;

html,
body,
#root {
  min-height: 100%;
}

body {
  background:
    radial-gradient(1200px 600px at 10% -10%, rgba(91, 124, 250, 0.18), transparent 50%),
    radial-gradient(800px 500px at 100% 0%, rgba(56, 189, 248, 0.08), transparent 45%),
    #07080d;
}

.card {
  @apply rounded-2xl border border-white/10 bg-white/[0.04] shadow-xl shadow-black/20 backdrop-blur;
}

.btn {
  @apply inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-50;
}

.btn-primary {
  @apply btn bg-accent-500 text-white hover:bg-accent-400;
}

.btn-ghost {
  @apply btn border border-white/10 bg-white/5 hover:bg-white/10;
}

.input {
  @apply w-full rounded-xl border border-white/10 bg-ink-900 px-3.5 py-2.5 text-sm text-slate-100 outline-none ring-accent-500/40 placeholder:text-slate-500 focus:border-accent-500 focus:ring-2;
}

.label {
  @apply mb-1.5 block text-xs font-medium uppercase tracking-wide text-slate-400;
}
