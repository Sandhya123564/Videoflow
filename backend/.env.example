# Copy this file to .env and fill in real values.
# Never commit .env.

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# true = ephemeral local DB so Phase 1 runs without Atlas. Data is lost on API restart.
USE_MEMORY_DB=true

# MongoDB Atlas connection string
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/videoflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://sandhyadsan03_db_user:g86CcLYZh1ux2SeV@cluster0.q7ktwmq.mongodb.net/?appName=Cluster0

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Review-link lifetime
REVIEW_TOKEN_DAYS=14
INVITE_DAYS=14

# true = skip verification emails locally (demo users can log in immediately)
SKIP_EMAIL_VERIFY=true

# --- Phase 2+ (leave blank until that phase) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
RESEND_FROM=VideoFlow <noreply@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave blank to use labeled demo mode (no real YouTube upload).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/v1/youtube/callback
